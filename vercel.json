{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(og-image.png|favicon.svg|favicon.ico|apple-touch-icon.png|Cow.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/en/about",
      "permanent": true
    },
    {
      "source": "/how-to-solve",
      "destination": "/en/how-to-solve",
      "permanent": true
    },
    {
      "source": "/difficulties",
      "destination": "/en/difficulties",
      "permanent": true
    },
    {
      "source": "/about-project",
      "destination": "/en/about-project",
      "permanent": true
    },
    {
      "source": "/welcome",
      "destination": "/en/welcome",
      "permanent": true
    },
    {
      "source": "/levels",
      "destination": "/en/levels",
      "permanent": true
    },
    {
      "source": "/levels/:path*",
      "destination": "/en/levels/:path*",
      "permanent": true
    },
    {
      "source": "/game/:path*",
      "destination": "/en/game/:path*",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "/en/login",
      "permanent": true
    },
    {
      "source": "/register",
      "destination": "/en/register",
      "permanent": true
    },
    {
      "source": "/forgot-password",
      "destination": "/en/forgot-password",
      "permanent": true
    },
    {
      "source": "/settings",
      "destination": "/en/settings",
      "permanent": true
    },
    {
      "source": "/statistics",
      "destination": "/en/statistics",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/verify-email",
      "destination": "/"
    },
    {
      "source": "/reset-password",
      "destination": "/"
    },
    {
      "source": "/auth/:path*",
      "destination": "/"
    },
    {
      "source": "/en",
      "destination": "/"
    },
    {
      "source": "/en/:path*",
      "destination": "/"
    },
    {
      "source": "/uk",
      "destination": "/"
    },
    {
      "source": "/uk/:path*",
      "destination": "/"
    }
  ]
}
