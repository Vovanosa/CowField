# Pooled connection the API uses at runtime.
DATABASE_URL=postgresql://user:password@host:5432/cowfield?schema=public
# Unpooled connection Prisma Migrate uses. Same database.
DIRECT_URL=postgresql://user:password@host:5432/cowfield?schema=public

PORT=4000
BULLPEN_ADMIN_EMAIL=your-admin@example.com

# REQUIRED in production — the server refuses to start without it when NODE_ENV=production.
# Comma-separated list of the origins the web app is served from; anything else is refused by CORS.
ALLOWED_ORIGINS=http://localhost:5173

VITE_API_BASE_URL=http://localhost:4000

# Neon Auth base URL. The browser signs in against it directly; the server uses it to fetch the
# JWKS it verifies player tokens against, and to check each token's `iss` and `aud`.
VITE_NEON_AUTH_URL=
NEON_AUTH_URL=

# Optional. The exact `aud` a Neon JWT must carry. Neon defaults it to the auth base URL, which is
# what the server checks for when this is empty. Set it if Neon is configured with a custom
# audience — doing so also makes a token with no `aud` at all a rejection.
NEON_AUTH_AUDIENCE=

# REQUIRED behind a proxy or load balancer, which any real deployment is. Express's `trust proxy`
# value (`1`, `loopback`, a CIDR, ...). The rate limiter keys on `request.ip`: unset behind a proxy,
# every player shares one bucket; set when nothing strips `X-Forwarded-For`, a caller can forge its
# own key. The server warns at startup if this is unset in production.
TRUST_PROXY=
